//@version=6
indicator("AIFX Sentinel V4 · Flexible Signals + AI Review", overlay=true,
     max_boxes_count=300, max_lines_count=300, max_labels_count=300)

// ---------------- SETTINGS ----------------
barsToSend = input.int(200, "Initial history candles", minval=50, maxval=200)
pivotLen = input.int(5, "Swing pivot length", minval=2, maxval=20)
obLookback = input.int(20, "Order Block search bars", minval=3, maxval=100)
zoneExtend = input.int(80, "Zone extension", minval=10, maxval=300)
equalAtrFactor = input.float(0.10, "Equal high/low ATR tolerance", minval=0.01, maxval=0.5)
showFVG = input.bool(true, "Show FVG")
showOB = input.bool(true, "Show Order Blocks")
showStructure = input.bool(true, "Show BOS / CHoCH")
showLiquidity = input.bool(true, "Show liquidity sweeps / EQH / EQL")
showPD = input.bool(true, "Show Premium / Discount")
showMA = input.bool(true, "Show EMAs")
showDashboard = input.bool(true, "Show dashboard")
enableExport = input.bool(true, "Enable webhook export")
maxDrawnZones = input.int(25, "Maximum active zones per type", minval=5, maxval=80)
minCandidateScore = input.int(3, "Candidate minimum points (lower = more signals)", minval=2, maxval=5)
candidateCooldown = input.int(3, "Bars between same-direction candidates", minval=0, maxval=30)
showCandidateSignals = input.bool(true, "Show BUY/SELL candidate labels")

// ---------------- INDICATORS ----------------
ema20 = ta.ema(close, 20)
ema50 = ta.ema(close, 50)
ema100 = ta.ema(close, 100)
ema200 = ta.ema(close, 200)
[macdLine, macdSignal, macdHist] = ta.macd(close, 12, 26, 9)
rsi = ta.rsi(close, 14)
atr = ta.atr(14)
[plusDI, minusDI, adx] = ta.dmi(14, 14)
plot(showMA ? ema20 : na, "EMA 20", color=color.yellow)
plot(showMA ? ema50 : na, "EMA 50", color=color.orange)
plot(showMA ? ema100 : na, "EMA 100", color=color.aqua)
plot(showMA ? ema200 : na, "EMA 200", color=color.fuchsia)

// ---------------- SWING STRUCTURE ----------------
ph = ta.pivothigh(high, pivotLen, pivotLen)
pl = ta.pivotlow(low, pivotLen, pivotLen)
var float lastSwingHigh = na
var float lastSwingLow = na
var float prevSwingHigh = na
var float prevSwingLow = na
var bool highAlreadyBroken = false
var bool lowAlreadyBroken = false
var int structureTrend = 0
var string structureName = "UNDEFINED"
if not na(ph)
    prevSwingHigh := lastSwingHigh
    lastSwingHigh := ph
    highAlreadyBroken := false
if not na(pl)
    prevSwingLow := lastSwingLow
    lastSwingLow := pl
    lowAlreadyBroken := false
bullBosRaw = ta.crossover(close, lastSwingHigh)
bearBosRaw = ta.crossunder(close, lastSwingLow)
bullBos = barstate.isconfirmed and not na(lastSwingHigh) and bullBosRaw and not highAlreadyBroken
bearBos = barstate.isconfirmed and not na(lastSwingLow) and bearBosRaw and not lowAlreadyBroken
bullChoch = bullBos and structureTrend == -1
bearChoch = bearBos and structureTrend == 1
if bullBos
    highAlreadyBroken := true
    structureTrend := 1
    if showStructure
        label.new(bar_index, high, bullChoch ? "CHoCH ↑" : "BOS ↑", style=label.style_label_down, color=color.green, textcolor=color.white)
        line.new(bar_index, lastSwingHigh, bar_index + zoneExtend, lastSwingHigh, color=color.green, width=2)
if bearBos
    lowAlreadyBroken := true
    structureTrend := -1
    if showStructure
        label.new(bar_index, low, bearChoch ? "CHoCH ↓" : "BOS ↓", style=label.style_label_up, color=color.red, textcolor=color.white)
        line.new(bar_index, lastSwingLow, bar_index + zoneExtend, lastSwingLow, color=color.red, width=2)
if not na(lastSwingHigh) and not na(prevSwingHigh) and not na(lastSwingLow) and not na(prevSwingLow)
    structureName := lastSwingHigh > prevSwingHigh and lastSwingLow > prevSwingLow ? "HH_HL" : lastSwingHigh < prevSwingHigh and lastSwingLow < prevSwingLow ? "LH_LL" : "MIXED"

// ---------------- EQUAL HIGHS / LOWS ----------------
eqh = not na(ph) and not na(prevSwingHigh) and math.abs(ph - prevSwingHigh) <= atr * equalAtrFactor
eql = not na(pl) and not na(prevSwingLow) and math.abs(pl - prevSwingLow) <= atr * equalAtrFactor
if showLiquidity and eqh
    label.new(bar_index - pivotLen, ph, "EQH", style=label.style_label_down, color=color.new(color.orange, 10), textcolor=color.white)
if showLiquidity and eql
    label.new(bar_index - pivotLen, pl, "EQL", style=label.style_label_up, color=color.new(color.aqua, 10), textcolor=color.black)
sweepHigh = barstate.isconfirmed and not na(lastSwingHigh) and high > lastSwingHigh and close < lastSwingHigh and not highAlreadyBroken
sweepLow = barstate.isconfirmed and not na(lastSwingLow) and low < lastSwingLow and close > lastSwingLow and not lowAlreadyBroken
if showLiquidity and sweepHigh
    label.new(bar_index, high, "BSL SWEEP", style=label.style_label_down, color=color.orange, textcolor=color.black)
if showLiquidity and sweepLow
    label.new(bar_index, low, "SSL SWEEP", style=label.style_label_up, color=color.aqua, textcolor=color.black)

// ---------------- FAIR VALUE GAPS ----------------
bullFVG = barstate.isconfirmed and bar_index >= 2 and low > high[2]
bearFVG = barstate.isconfirmed and bar_index >= 2 and high < low[2]
var box[] fvgBoxes = array.new_box()
var bool[] fvgBull = array.new_bool()
var bool bullFvgMitigatedEvent = false
var bool bearFvgMitigatedEvent = false
bullFvgMitigatedEvent := false
bearFvgMitigatedEvent := false
if showFVG and bullFVG
    bx = box.new(bar_index - 2, low, bar_index + zoneExtend, high[2], bgcolor=color.new(color.lime, 86), border_color=color.new(color.lime, 25))
    array.push(fvgBoxes, bx)
    array.push(fvgBull, true)
if showFVG and bearFVG
    bx = box.new(bar_index - 2, low[2], bar_index + zoneExtend, high, bgcolor=color.new(color.red, 86), border_color=color.new(color.red, 25))
    array.push(fvgBoxes, bx)
    array.push(fvgBull, false)
int fi = array.size(fvgBoxes) - 1
while fi >= 0
    bx = array.get(fvgBoxes, fi)
    isBull = array.get(fvgBull, fi)
    top = box.get_top(bx)
    bottom = box.get_bottom(bx)
    filled = isBull ? low <= bottom : high >= top
    if filled
        if isBull
            bullFvgMitigatedEvent := true
        else
            bearFvgMitigatedEvent := true
        box.delete(bx)
        array.remove(fvgBoxes, fi)
        array.remove(fvgBull, fi)
    fi -= 1
while array.size(fvgBoxes) > maxDrawnZones
    box.delete(array.shift(fvgBoxes))
    array.shift(fvgBull)

// ---------------- ORDER BLOCKS ----------------
var box[] obBoxes = array.new_box()
var bool[] obBull = array.new_bool()
var bool bullObEvent = false
var bool bearObEvent = false
var bool bullObInvalidatedEvent = false
var bool bearObInvalidatedEvent = false
bullObEvent := false
bearObEvent := false
bullObInvalidatedEvent := false
bearObInvalidatedEvent := false
if showOB and bullBos
    bool foundBull = false
    for j = 1 to obLookback
        if not foundBull and close[j] < open[j]
            ob = box.new(bar_index-j, high[j], bar_index+zoneExtend, low[j], bgcolor=color.new(color.green, 88), border_color=color.new(color.green, 30))
            array.push(obBoxes, ob)
            array.push(obBull, true)
            foundBull := true
            bullObEvent := true
if showOB and bearBos
    bool foundBear = false
    for j = 1 to obLookback
        if not foundBear and close[j] > open[j]
            ob = box.new(bar_index-j, high[j], bar_index+zoneExtend, low[j], bgcolor=color.new(color.maroon, 88), border_color=color.new(color.red, 30))
            array.push(obBoxes, ob)
            array.push(obBull, false)
            foundBear := true
            bearObEvent := true
int oi = array.size(obBoxes) - 1
while oi >= 0
    ob = array.get(obBoxes, oi)
    isBullOb = array.get(obBull, oi)
    invalid = isBullOb ? close < box.get_bottom(ob) : close > box.get_top(ob)
    if invalid
        if isBullOb
            bullObInvalidatedEvent := true
        else
            bearObInvalidatedEvent := true
        box.delete(ob)
        array.remove(obBoxes, oi)
        array.remove(obBull, oi)
    oi -= 1
while array.size(obBoxes) > maxDrawnZones
    box.delete(array.shift(obBoxes))
    array.shift(obBull)

// ---------------- PREMIUM / DISCOUNT ----------------
rangeHigh = lastSwingHigh
rangeLow = lastSwingLow
midpoint = not na(rangeHigh) and not na(rangeLow) ? (rangeHigh + rangeLow) / 2.0 : na
premium = not na(midpoint) and close > midpoint
discount = not na(midpoint) and close < midpoint
plot(showPD ? midpoint : na, "Dealing Range EQ 50%", color=color.new(color.yellow, 10), linewidth=1, style=plot.style_linebr)
plot(lastSwingHigh, "Resistance / Swing High", color=color.new(color.red, 45), style=plot.style_stepline)
plot(lastSwingLow, "Support / Swing Low", color=color.new(color.blue, 45), style=plot.style_stepline)
bgcolor(showPD and premium ? color.new(color.red, 96) : showPD and discount ? color.new(color.green, 96) : na)

// ---------------- FLEXIBLE CANDIDATE SIGNAL ENGINE ----------------
bullPoints = (ema20 > ema50 ? 1 : 0) + (close > ema20 ? 1 : 0) + (macdHist > 0 ? 1 : 0) + (rsi > 50 ? 1 : 0) + (close > close[1] ? 1 : 0) + ((bullBos or bullChoch or bullFVG or sweepLow) ? 1 : 0)
bearPoints = (ema20 < ema50 ? 1 : 0) + (close < ema20 ? 1 : 0) + (macdHist < 0 ? 1 : 0) + (rsi < 50 ? 1 : 0) + (close < close[1] ? 1 : 0) + ((bearBos or bearChoch or bearFVG or sweepHigh) ? 1 : 0)
var int lastBullCandidateBar = na
var int lastBearCandidateBar = na
bullCooldownOk = na(lastBullCandidateBar) or bar_index - lastBullCandidateBar > candidateCooldown
bearCooldownOk = na(lastBearCandidateBar) or bar_index - lastBearCandidateBar > candidateCooldown
bullCandidate = barstate.isconfirmed and bullPoints >= minCandidateScore and bullPoints > bearPoints and bullCooldownOk
bearCandidate = barstate.isconfirmed and bearPoints >= minCandidateScore and bearPoints > bullPoints and bearCooldownOk
if bullCandidate
    lastBullCandidateBar := bar_index
if bearCandidate
    lastBearCandidateBar := bar_index
candidateDirection = bullCandidate ? "BUY" : bearCandidate ? "SELL" : "NONE"
if showCandidateSignals and bullCandidate
    label.new(bar_index, low, "BUY CANDIDATE\n" + str.tostring(bullPoints) + "/6", style=label.style_label_up, color=color.lime, textcolor=color.black)
if showCandidateSignals and bearCandidate
    label.new(bar_index, high, "SELL CANDIDATE\n" + str.tostring(bearPoints) + "/6", style=label.style_label_down, color=color.red, textcolor=color.white)

// ---------------- JSON EXPORT ----------------
bullFvgEvent = bullFVG
bearFvgEvent = bearFVG
f_bool(bool x) => x ? "true" : "false"
f_num(float x) => na(x) ? "null" : str.tostring(x, "#.########")
f_candle(int offset) =>
    string pd = na(midpoint[offset]) ? "unknown" : close[offset] > midpoint[offset] ? "premium" : "discount"
    string events = '"events":{"structure":"' + structureName[offset] + '","bull_bos":' + f_bool(bullBos[offset]) + ',"bear_bos":' + f_bool(bearBos[offset]) + ',"bull_choch":' + f_bool(bullChoch[offset]) + ',"bear_choch":' + f_bool(bearChoch[offset]) + ',"bull_fvg":' + f_bool(bullFvgEvent[offset]) + ',"bear_fvg":' + f_bool(bearFvgEvent[offset]) + ',"bull_fvg_mitigated":' + f_bool(bullFvgMitigatedEvent[offset]) + ',"bear_fvg_mitigated":' + f_bool(bearFvgMitigatedEvent[offset]) + ',"bull_ob":' + f_bool(bullObEvent[offset]) + ',"bear_ob":' + f_bool(bearObEvent[offset]) + ',"bull_ob_invalidated":' + f_bool(bullObInvalidatedEvent[offset]) + ',"bear_ob_invalidated":' + f_bool(bearObInvalidatedEvent[offset]) + ',"sweep_high":' + f_bool(sweepHigh[offset]) + ',"sweep_low":' + f_bool(sweepLow[offset]) + ',"eqh":' + f_bool(eqh[offset]) + ',"eql":' + f_bool(eql[offset]) + ',"candidate_direction":"' + candidateDirection[offset] + '","candidate_bull_score":' + str.tostring(bullPoints[offset]) + ',"candidate_bear_score":' + str.tostring(bearPoints[offset]) + ',"premium_discount":"' + pd + '"}'
    '{"time":' + str.tostring(time[offset]) + ',"open":' + f_num(open[offset]) + ',"high":' + f_num(high[offset]) + ',"low":' + f_num(low[offset]) + ',"close":' + f_num(close[offset]) + ',"volume":' + f_num(nz(volume[offset], 0)) + ',"ema20":' + f_num(ema20[offset]) + ',"ema50":' + f_num(ema50[offset]) + ',"ema100":' + f_num(ema100[offset]) + ',"ema200":' + f_num(ema200[offset]) + ',"macd":' + f_num(macdLine[offset]) + ',"macd_signal":' + f_num(macdSignal[offset]) + ',"macd_hist":' + f_num(macdHist[offset]) + ',"rsi":' + f_num(rsi[offset]) + ',"atr":' + f_num(atr[offset]) + ',"adx":' + f_num(adx[offset]) + ',"plus_di":' + f_num(plusDI[offset]) + ',"minus_di":' + f_num(minusDI[offset]) + ',' + events + '}'

// ---------------- WEBHOOK STREAM ----------------
var bool initialized = false
var table dash = table.new(position.top_right, 2, 11, bgcolor=color.new(color.black, 12), frame_color=color.gray, border_width=1)
if barstate.islast and showDashboard
    table.cell(dash,0,0,"AIFX SENTINEL V4",bgcolor=color.rgb(20,40,65),text_color=color.white)
    table.cell(dash,1,0,"SMC + AI REVIEW",bgcolor=color.rgb(20,40,65),text_color=color.aqua)
    table.cell(dash,0,1,"Symbol / TF")
    table.cell(dash,1,1,syminfo.tickerid+" / "+timeframe.period)
    table.cell(dash,0,2,"Structure")
    table.cell(dash,1,2,structureName)
    table.cell(dash,0,3,"Trend")
    table.cell(dash,1,3,close>ema20 and ema20>ema50?"BULLISH":close<ema20 and ema20<ema50?"BEARISH":"SIDEWAYS")
    table.cell(dash,0,4,"RSI / ADX")
    table.cell(dash,1,4,str.tostring(rsi,"#.0")+" / "+str.tostring(adx,"#.0"))
    table.cell(dash,0,5,"MACD Hist")
    table.cell(dash,1,5,str.tostring(macdHist,"#.#####"))
    table.cell(dash,0,6,"FVG")
    table.cell(dash,1,6,bullFVG?"BULL":bearFVG?"BEAR":"—")
    table.cell(dash,0,7,"Liquidity")
    table.cell(dash,1,7,sweepLow?"SSL sweep":sweepHigh?"BSL sweep":eqh?"EQH":eql?"EQL":"—")
    table.cell(dash,0,8,"Location")
    table.cell(dash,1,8,premium?"PREMIUM":discount?"DISCOUNT":"UNKNOWN")
    table.cell(dash,0,9,"Candidate")
    table.cell(dash,1,9,candidateDirection + " · " + str.tostring(math.max(bullPoints,bearPoints)) + "/6")
    table.cell(dash,0,10,"Export")
    table.cell(dash,1,10,initialized?"STREAMING":"WAITING")
if enableExport and barstate.islast and barstate.isrealtime and barstate.isconfirmed
    if not initialized and bar_index >= barsToSend - 1
        string arr = ""
        for k = 0 to barsToSend - 1
            int off = barsToSend - 1 - k
            arr += (k == 0 ? "" : ",") + f_candle(off)
        string batch = '{"symbol":"' + syminfo.tickerid + '","market":"' + (syminfo.type=="forex"?"forex":syminfo.type=="crypto"?"crypto":syminfo.type) + '","timeframe":"' + timeframe.period + '","candles":[' + arr + ']}'
        alert(batch, alert.freq_once_per_bar_close)
        initialized := true
    else if initialized
        string live = '{"symbol":"' + syminfo.tickerid + '","market":"' + (syminfo.type=="forex"?"forex":syminfo.type=="crypto"?"crypto":syminfo.type) + '","timeframe":"' + timeframe.period + '","candles":[' + f_candle(0) + ']}'
        alert(live, alert.freq_once_per_bar_close)
alertcondition(bullBos,"Bullish BOS","AIFX bullish BOS")
alertcondition(bearBos,"Bearish BOS","AIFX bearish BOS")
alertcondition(bullChoch,"Bullish CHoCH","AIFX bullish CHoCH")
alertcondition(bearChoch,"Bearish CHoCH","AIFX bearish CHoCH")
alertcondition(bullFVG,"Bullish FVG","AIFX bullish FVG")
alertcondition(bearFVG,"Bearish FVG","AIFX bearish FVG")
alertcondition(sweepHigh,"Buy-side liquidity sweep","AIFX BSL sweep")
alertcondition(sweepLow,"Sell-side liquidity sweep","AIFX SSL sweep")
alertcondition(bullCandidate,"BUY candidate","AIFX BUY candidate — AI review required")
alertcondition(bearCandidate,"SELL candidate","AIFX SELL candidate — AI review required")
